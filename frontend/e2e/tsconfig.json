{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["./**/*"],
  "compilerOptions": {
    // Playwright evalúa código en el navegador: se necesitan los tipos del DOM.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@/*": ["../src/*"]
    }
  }
}
