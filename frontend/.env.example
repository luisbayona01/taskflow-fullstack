# URL base de la API REST de TaskFlow (backend Laravel).
# Opciones:
#   - URL absoluta (por defecto):  http://127.0.0.1:8000/api
#   - Relativa usando el proxy de Vite: /api
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Destino del proxy de Vite (sólo servidor de desarrollo, no se compila).
# Con el backend levantado en Docker la API está en el puerto 8010:
#   DEV_PROXY_TARGET=http://127.0.0.1:8010
DEV_PROXY_TARGET=http://127.0.0.1:8000
